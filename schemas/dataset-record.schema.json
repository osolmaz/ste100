{
  "$defs": {
    "ByteRange": {
      "additionalProperties": false,
      "description": "A half-open byte range into UTF-8 encoded text.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ByteRange",
      "type": "object"
    },
    "ProtectedSpan": {
      "additionalProperties": false,
      "properties": {
        "byte_range": {
          "$ref": "#/$defs/ByteRange"
        },
        "kind": {
          "enum": [
            "project_term",
            "number",
            "unit",
            "identifier",
            "url",
            "code",
            "caller"
          ],
          "title": "Kind",
          "type": "string"
        },
        "span_id": {
          "pattern": "^span_[0-9a-f]{16}$",
          "title": "Span Id",
          "type": "string"
        },
        "text_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "kind",
        "byte_range",
        "text_digest"
      ],
      "title": "ProtectedSpan",
      "type": "object"
    },
    "SplitMembership": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "model_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Family"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test",
            "sealed_test"
          ],
          "title": "Split",
          "type": "string"
        },
        "time_bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Bucket"
        }
      },
      "required": [
        "split",
        "group_id"
      ],
      "title": "SplitMembership",
      "type": "object"
    },
    "ViolationAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotator": {
          "minLength": 1,
          "title": "Annotator",
          "type": "string"
        },
        "byte_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "label": {
          "enum": [
            "violation",
            "no_violation",
            "exception",
            "uncertain"
          ],
          "title": "Label",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^(?:[1-9]\\d*\\.[1-9]\\d*|GR-[1-9]\\d*)$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "label",
        "annotator"
      ],
      "title": "ViolationAnnotation",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_state": {
      "enum": [
        "weak",
        "reviewed",
        "adjudicated"
      ],
      "title": "Annotation State",
      "type": "string"
    },
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ViolationAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "inferred_approval": {
      "const": false,
      "default": false,
      "title": "Inferred Approval",
      "type": "boolean"
    },
    "observed_outcome": {
      "default": "not_applicable",
      "enum": [
        "revision_requested",
        "continued_without_revision",
        "conversation_ended",
        "explicit_approval",
        "not_applicable"
      ],
      "title": "Observed Outcome",
      "type": "string"
    },
    "parent_record_ids": {
      "default": [],
      "items": {
        "pattern": "^record_[0-9a-f]{16}$",
        "type": "string"
      },
      "title": "Parent Record Ids",
      "type": "array"
    },
    "protected_spans": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProtectedSpan"
      },
      "title": "Protected Spans",
      "type": "array"
    },
    "record_id": {
      "pattern": "^record_[0-9a-f]{16}$",
      "title": "Record Id",
      "type": "string"
    },
    "rule_ids": {
      "default": [],
      "items": {
        "pattern": "^(?:[1-9]\\d*\\.[1-9]\\d*|GR-[1-9]\\d*)$",
        "type": "string"
      },
      "title": "Rule Ids",
      "type": "array"
    },
    "source_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "standard_example",
        "technical_document",
        "conversation_revision",
        "synthetic"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/SplitMembership"
    },
    "target_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Text"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "source_kind",
    "source_id",
    "source_digest",
    "text",
    "split",
    "annotation_state"
  ],
  "title": "DatasetRecord",
  "type": "object"
}
