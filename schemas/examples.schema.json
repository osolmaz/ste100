{
  "$defs": {
    "ReviewState": {
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "row": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "source_file",
        "source_digest"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "StandardExample": {
      "additionalProperties": false,
      "properties": {
        "example_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Example Id",
          "type": "string"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "label": {
          "enum": [
            "positive",
            "negative",
            "exception",
            "boundary"
          ],
          "title": "Label",
          "type": "string"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        },
        "rule_ids": {
          "items": {
            "pattern": "^(?:[1-9]\\d*\\.[1-9]\\d*|GR-[1-9]\\d*)$",
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/SourceLocation"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "example_id",
        "rule_ids",
        "text",
        "label",
        "review_state",
        "source"
      ],
      "title": "StandardExample",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/StandardExample"
  },
  "type": "array"
}
