{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "base_model_id": {
      "minLength": 1,
      "title": "Base Model Id",
      "type": "string"
    },
    "base_model_revision": {
      "minLength": 1,
      "title": "Base Model Revision",
      "type": "string"
    },
    "dataset_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Dataset Digests",
      "type": "array"
    },
    "detector_hints_used": {
      "title": "Detector Hints Used",
      "type": "boolean"
    },
    "evaluation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evaluation Digest",
      "type": "string"
    },
    "format_version": {
      "const": "1",
      "title": "Format Version",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "official_compliance_claimed": {
      "const": false,
      "default": false,
      "title": "Official Compliance Claimed",
      "type": "boolean"
    },
    "pretraining_contamination": {
      "enum": [
        "known_absent",
        "known_present",
        "unknown"
      ],
      "title": "Pretraining Contamination",
      "type": "string"
    },
    "protected_content_gate": {
      "title": "Protected Content Gate",
      "type": "boolean"
    },
    "release": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Release",
      "type": "string"
    },
    "role": {
      "enum": [
        "detector",
        "rewriter"
      ],
      "title": "Role",
      "type": "string"
    },
    "selection_authority": {
      "const": "maintainer",
      "default": "maintainer",
      "title": "Selection Authority",
      "type": "string"
    },
    "span_release_gate": {
      "enum": [
        "report_only",
        "blocking"
      ],
      "title": "Span Release Gate",
      "type": "string"
    },
    "standard_issue": {
      "minimum": 1,
      "title": "Standard Issue",
      "type": "integer"
    },
    "thresholds": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "title": "Thresholds",
      "type": "object"
    }
  },
  "required": [
    "format_version",
    "model_id",
    "role",
    "release",
    "artifact_digest",
    "evaluation_digest",
    "standard_issue",
    "base_model_id",
    "base_model_revision",
    "pretraining_contamination",
    "dataset_digests",
    "thresholds",
    "protected_content_gate",
    "span_release_gate",
    "detector_hints_used"
  ],
  "title": "ModelManifest",
  "type": "object"
}
