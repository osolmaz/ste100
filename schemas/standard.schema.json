{
  "$defs": {
    "ExpectedCounts": {
      "additionalProperties": false,
      "properties": {
        "approved_words": {
          "minimum": 0,
          "title": "Approved Words",
          "type": "integer"
        },
        "general_rules": {
          "minimum": 0,
          "title": "General Rules",
          "type": "integer"
        },
        "numbered_rules": {
          "minimum": 0,
          "title": "Numbered Rules",
          "type": "integer"
        },
        "unapproved_words": {
          "minimum": 0,
          "title": "Unapproved Words",
          "type": "integer"
        }
      },
      "required": [
        "numbered_rules",
        "general_rules",
        "approved_words",
        "unapproved_words"
      ],
      "title": "ExpectedCounts",
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "row": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "source_file",
        "source_digest"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expected_counts": {
      "$ref": "#/$defs/ExpectedCounts"
    },
    "file_digests": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "File Digests",
      "type": "object"
    },
    "format_version": {
      "const": "1",
      "title": "Format Version",
      "type": "string"
    },
    "issue": {
      "const": 9,
      "title": "Issue",
      "type": "integer"
    },
    "review_state": {
      "$ref": "#/$defs/ReviewState"
    },
    "source": {
      "$ref": "#/$defs/SourceLocation"
    },
    "standard_id": {
      "const": "ASD-STE100",
      "title": "Standard Id",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "standard_id",
    "issue",
    "review_state",
    "source",
    "expected_counts",
    "file_digests"
  ],
  "title": "StandardManifest",
  "type": "object"
}
