      "line_start": null,
      "page": 67,
      "row": null,
      "source_digest": "sha256:a216fe199bd6e9c77fc743dfe6dc081ee5f245adcb115ed6ca1aa45ee50fa3f5",
      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Use the active voice. In descriptive writing, you can use the passive voice only when the agent is unknown.",
