      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Use key words and key phrases to give your text a logical structure.",
    "rule_id": "6.2",
    "source": {
      "line_end": null,
      "line_start": null,
      "page": 95,
      "row": null,
      "source_digest": "sha256:a216fe199bd6e9c77fc743dfe6dc081ee5f245adcb115ed6ca1aa45ee50fa3f5",
      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Write short sentences. Use a maximum of 25 words in each sentence.",
    "rule_id": "6.3",
    "source": {
      "line_end": null,
      "line_start": null,
      "page": 95,
      "row": null,
      "source_digest": "sha256:a216fe199bd6e9c77fc743dfe6dc081ee5f245adcb115ed6ca1aa45ee50fa3f5",
      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Use paragraphs to show related information.",
    "rule_id": "6.4",
    "source": {
      "line_end": null,
      "line_start": null,
      "page": 95,
      "row": null,
      "source_digest": "sha256:a216fe199bd6e9c77fc743dfe6dc081ee5f245adcb115ed6ca1aa45ee50fa3f5",
      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Make sure that each paragraph has only one topic.",
