      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Use only the verb forms that are given in the dictionary.",
    "rule_id": "3.1",
    "source": {
      "line_end": null,
      "line_start": null,
      "page": 67,
