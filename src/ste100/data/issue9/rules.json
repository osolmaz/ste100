    }
  },
  {
    "requirement": "When a technical noun has more than three words, write it in full. Then, you can use one of these methods to make the technical noun clear: - Give a shorter form of the technical noun. - Use hyphens (-) between words that you use as one unit.",
    "rule_id": "2.2",
    "source": {
      "line_end": null,
      "line_start": null,
