      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Use only these verb forms and tenses of verbs: - The infinitive form - The imperative form (command form) - The simple present tense - The simple past tense - The simple future tense - The past participle form (as an adjective).",
    "rule_id": "3.2",
    "source": {
      "line_end": null,
      "line_start": null,
      "page": 67,
      "row": null,
      "source_digest": "sha256:a216fe199bd6e9c77fc743dfe6dc081ee5f245adcb115ed6ca1aa45ee50fa3f5",
      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
    "requirement": "Use the past participle form as an adjective.",
    "rule_id": "3.3",
    "source": {
      "line_end": null,
      "line_start": null,
      "page": 67,
      "row": null,
      "source_digest": "sha256:a216fe199bd6e9c77fc743dfe6dc081ee5f245adcb115ed6ca1aa45ee50fa3f5",
      "source_file": "ASD-STE100_ISSUE9.txt"
    }
  },
  {
